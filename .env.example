# =============================================================================
# Home Improvement Marketplace — Environment Variables
# Copy this file to `.env` and fill in the values.
# =============================================================================

# --- Server ---
NODE_ENV=development
PORT=3000
# Public base URL of the app (used for email links). No trailing slash.
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketplace?schema=public"

# --- Auth ---
# Generate a strong secret, e.g.  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
# Access token lifetime (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN="7d"

# --- CORS ---
# Comma-separated list of allowed origins for the API / Socket.io.
CORS_ORIGINS="http://localhost:3000"

# --- File storage ---
# "local" stores files under /public/uploads. "s3" uses the AWS settings below.
STORAGE_DRIVER=local

# --- AWS S3 (only required when STORAGE_DRIVER=s3) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Optional CDN/base URL for serving S3 objects. Defaults to the S3 endpoint.
AWS_S3_PUBLIC_URL=

# --- Email ---
# "console" prints emails to the server log (great for local dev).
# "smtp" would be wired to a provider in production.
MAIL_DRIVER=console
MAIL_FROM="Home Improvement Marketplace <no-reply@marketplace.local>"
