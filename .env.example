# MadeHere environment variables — PLACEHOLDER NAMES ONLY.
# Copy to .env.local and fill with real values. NEVER commit real secrets.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only. Never exposed to the client. Grants elevated DB access.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Database (db:* scripts and RLS integration tests) ---
# Direct Postgres connection string: local dev Postgres or the Supabase
# "direct connection" string. Used by npm run db:migrate/db:types/db:seed
# and by tests/integration/rls.test.ts (skipped when unset).
DATABASE_URL=postgresql://postgres@127.0.0.1:54322/madehere

# --- Stripe (test mode first) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs for the Verified / Featured plans (created in Stripe dashboard)
STRIPE_PRICE_VERIFIED=price_xxx
STRIPE_PRICE_FEATURED=price_xxx

# --- Resend (transactional email) ---
RESEND_API_KEY=re_xxx
EMAIL_FROM="MadeHere <notifications@example.com>"
ADMIN_ALERT_EMAIL=admin@example.com

# --- Rate limiting / spam protection ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=10
